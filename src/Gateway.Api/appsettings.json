{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",

  "Kestrel": { "Endpoints": { "Http": { "Url": "http://0.0.0.0:8080" } } },

  "ReverseProxy": {
    "Routes": {
      "users-swagger": {
        "ClusterId": "users",
        "Order": 0,
        "Match": { "Path": "/users/swagger/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/users" }]
      },
      "events-swagger": {
        "ClusterId": "events",
        "Order": 0,
        "Match": { "Path": "/events/swagger/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/events" }]
      },
      "notification-swagger": {
        "ClusterId": "notification",
        "Order": 0,
        "Match": { "Path": "/notification/swagger/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/notification" }]
      },
      "order-swagger": {
        "ClusterId": "orders",
        "Order": 0,
        "Match": { "Path": "/orders/swagger/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/orders" }]
      },
      "payment-swagger": {
        "ClusterId": "payments",
        "Order": 0,
        "Match": { "Path": "/payments/swagger/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/payments" }]
      },
      "ticket-swagger": {
        "ClusterId": "tickets",
        "Order": 0,
        "Match": { "Path": "/tickets/swagger/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/tickets" }]
      },
      "users-route": {
        "ClusterId": "users",
        "Order": 10,
        "Match": { "Path": "/users/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/users" }]
      },
      "events-route": {
        "ClusterId": "events",
        "Order": 10,
        "Match": { "Path": "/events/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/events" }]
      },
      "notification-route": {
        "ClusterId": "notification",
        "Order": 10,
        "Match": { "Path": "/notification/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/notification" }]
      },
      "orders-route": {
        "ClusterId": "orders",
        "Order": 10,
        "Match": { "Path": "/orders/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/orders" }]
      },
      "payment-route": {
        "ClusterId": "payments",
        "Order": 10,
        "Match": { "Path": "/payments/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/payments" }]
      },
      "ticket-route": {
        "ClusterId": "tickets",
        "Order": 10,
        "Match": { "Path": "/tickets/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/tickets" }]
      }
    },

    "Clusters": {
      "users": { "Destinations": { "u1": { "Address": "http://userservice" } } },
      "events": { "Destinations": { "e1": { "Address": "http://eventservice:5000" } } },
      "notification":  { "Destinations": { "n1": { "Address": "http://notificationservice:2342" } } },
      "orders": { "Destinations": { "o1": { "Address": "http://order-service:8083/" } } },
      "payments": { "Destinations": { "p1": { "Address": "http://payment-service:8082/" } } },
      "tickets": { "Destinations": { "t1": { "Address": "http://ticket-service:8084/" } } }
    }
  }
}
